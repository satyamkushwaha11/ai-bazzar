{
  "name": "ai-ecommerce-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @repo/db generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:push": "pnpm --filter @repo/db push",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:studio": "pnpm --filter @repo/db studio",
    "db:seed": "pnpm --filter @repo/db seed",
    "db:seed:bulk": "pnpm --filter @repo/db seed:bulk",
    "db:seed:catalog": "pnpm --filter @repo/db seed:catalog",
    "db:embed": "pnpm --filter @repo/db embed",
    "db:generate": "pnpm --filter @repo/db generate"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9"
  }
}
