# ---------------------------------------------------------------------------
# AI Bazaar — environment
#
# Copy to .env for local dev. On Vercel: Project → Settings → Environment
# Variables.
#
# IMPORTANT (monorepo): Turborepo strips any variable not declared in
# turbo.json, even when it IS set correctly in Vercel — the build silently sees
# undefined. If you add a variable here, add it to turbo.json `build.env` too.
# ---------------------------------------------------------------------------


# ============ REQUIRED ============

# Neon Postgres.
# DATABASE_URL must be the POOLED connection (host contains "-pooler").
# Serverless opens a connection per invocation and will exhaust a direct
# Postgres connection limit under real traffic.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The DIRECT (non-pooled) connection. Prisma needs it for migrations and DDL,
# which cannot run through pgbouncer.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Session signing. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Powers all the AI: the shopping assistant, the shopkeeper's replies, and the
# embeddings behind semantic search. Without it search falls back to keyword
# matching and the assistant returns 503.
OPENAI_API_KEY=""


# ============ RECOMMENDED IN PRODUCTION ============

# Rate limiting (Upstash Redis). Without these checkLimit() no-ops, leaving
# every AI endpoint unmetered — and each assistant turn costs real money.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Canonical site URL, used for metadataBase (Open Graph / link previews).
# Defaults to http://localhost:3000, which produces broken previews in prod.
NEXT_PUBLIC_APP_URL="https://your-domain.com"


# ============ OPTIONAL ============

# Chat + persona model. Defaults to gpt-4o-mini.
OPENAI_MODEL="gpt-4o-mini"

# Google sign-in. Leave BOTH blank to disable — the provider is only registered
# when both are set, and the login page hides the button to match.
# Email/password sign-in works without them.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# NextAuth auto-detects the URL on Vercel (VERCEL_URL + trustHost). Only set
# this when deploying elsewhere or behind a proxy.
# AUTH_URL="https://your-domain.com"

# Razorpay. Not needed today — checkout is Cash-on-Delivery only and the ONLINE
# method is gated off in lib/payments.ts. Fill these in when you enable it.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""


# ============ SCRIPTS ONLY — do not set in Vercel ============
# CATALOG_COUNT=50000    # pnpm db:seed:catalog target
# EMBED_CONCURRENCY=8    # pnpm db:embed parallelism
# FORCE=1                # pnpm db:embed — re-embed everything


# ---------------------------------------------------------------------------
# Removed as unused: RESEND_API_KEY, EMAIL_FROM, NEXT_PUBLIC_APP_NAME,
# NEXT_PUBLIC_POSTHOG_KEY, NEXT_PUBLIC_POSTHOG_HOST, NEXT_PUBLIC_SENTRY_DSN,
# PLATFORM_COMMISSION_PCT, UPLOADTHING_SECRET, UPLOADTHING_APP_ID.
# No code reads them — setting them in Vercel does nothing. Re-add here AND in
# turbo.json when you actually wire the feature up.
# ---------------------------------------------------------------------------
